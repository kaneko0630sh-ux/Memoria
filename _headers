# Cloudflare Pages: 毎回サーバーに更新の有無を確かめてから使う（変わっていなければ 304 で速い）。
# 反映した直後から新しい版が届き、古いファイルと新しいファイルが混ざらない
/*
  Cache-Control: no-cache
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https: http:; connect-src 'self' https: http: data: blob:; font-src 'self' data:; object-src 'none'; base-uri 'none'; form-action 'none'; frame-src 'none'; manifest-src 'self'; frame-ancestors 'none'
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
